# Copy this file to .env in this same folder (hw4/) and fill in your own Portkey key.
# Never commit the real .env — it's in .gitignore.

# Required: your Portkey API key, used to reach the model gateway the agent talks to.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional — these are the defaults backend/tools.py uses if left out.
OPENAI_MODEL=gpt6astra
PORTKEY_BASE_URL=https://api.portkey.ai/v1
